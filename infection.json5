{
    "$schema": "vendor/infection/infection/resources/schema.json",
    "source": {
        "directories": ["src"]
    },
    "logs": {
        "text": "php://stderr",
        "summary": "build/infection-summary.log"
    },
    // RedisBulkheadStore/ApcuBulkheadStore are covered by the Integration suite
    // (#[Covers], not #[CoversNothing] - the latter zeroes mutation attribution
    // entirely in testo/infection, it isn't merely deprioritized). Needs
    // REDIS_HOST + ext-apcu (apc.enable_cli=1) reachable, or their MSI drops.
    //
    // Run with `--with-uncovered` (composer mutation): code the tests execute but do
    // not name in #[Covers] is counted as Not Covered instead of being invisible, so
    // the MSI below is the overall one (measured 91% without the signature ignore
    // below, 93% with it).
    //
    // 86 is the honest floor for what infection's coverage-based test selection
    // can see (the equivalent `max(0,x)`->`max(-1,x)` mutants are provably
    // unkillable - x is never negative - but occasionally register as "killed"
    // by run-to-run noise rather than any real test, so don't read 87 in one run
    // as the gate moving; 86 is the value to set, not chase back up). Remaining
    // survivors are equivalent / performance-only mutants:
    //  - InMemoryBulkheadStore `$active[$token] = true` -> `false`: only the key
    //    matters to count(), the value is an unread marker;
    //  - SharedBulkhead/KeyedBulkhead/RedisBulkheadStore `max(0, ...)` -> `max(-1, ...)`: the
    //    difference is never negative (activeCount >= 0 always), floor unreachable;
    //  - RedisBulkheadStore::activeCounts `$replies[$index] ?? 0` -> `?? -1`: the
    //    missing-reply default sits inside the same `max(0, ...)` clamp, so any
    //    value <= 0 is observably identical;
    //  - ApcuBulkheadStore::tryAcquire `apcu_store(...) !== true` -> `return null`
    //    removal (the one Not Covered mutant left): apcu_store failing needs a
    //    full APCu segment, not reachable without faking the extension;
    //  - ApcuBulkheadStore::lock loop off-by-one (`$attempt=-1` / `<=`): changes
    //    the retry budget by one iteration, unobservable externally;
    //  - ApcuBulkheadStore::liveSlots `>` -> `>=`: a millisecond-boundary
    //    equality at expiry; no clock injection exists to hit it deterministically
    //    (same implicit-clock coupling as Redis's `TIME`-based Lua script);
    //  - ApcuBulkheadStore::release UnwrapFinally: the `finally`-only-runs-on
    //    exception difference needs apcu_store/liveSlots to throw, which isn't
    //    reachable without faking the extension;
    //  - ApcuBulkheadStore::isAvailable `&&` -> `||`: only distinguishable when
    //    ext-apcu is loaded but apc.enable_cli is off, a CLI-disabled-but-loaded
    //    state the test environments don't construct;
    //  - Internal\SlotWaiter::wait `max(1, (int) $budgetMs)` -> `max(0, ...)`: a
    //    context budget under 1 ms; a sub-millisecond-budget test was tried and did
    //    not kill it, so it is left as a known survivor;
    //  - Internal\SlotWaiter::jitteredPollInterval ReturnRemoval on the jitter==0 early
    //    return: the fall-through computes maxDelta=0 and returns an identical
    //    interval — performance-only;
    //  - Internal\SlotWaiter::jitteredPollInterval CastFloat on `(float) $micros`: the
    //    cast exists only to satisfy psalm's strict binary operands; int*float
    //    promotes identically without it;
    //  - Internal\SlotWaiter::jitteredPollInterval Plus -> Minus around
    //    `random_int(-$maxDelta, $maxDelta)`: the jitter distribution is symmetric,
    //    so +delta and -delta are provably the same distribution.
    "testFramework": "testo",
    "minMsi": 89,
    "mutators": {
        "@default": true,
        // Constructor/method parameter declarations with a default value
        // (`private int $x = 100,`, `float $pollJitter = 0.0,`): the mutant sits on a
        // signature line with no executable opcode under pcov, so it is reported Not
        // Covered whatever the tests do. Only a type-prefixed `$name = default,` line
        // matches; a body line cannot (no type before the variable).
        "global-ignoreSourceCodeByRegex": [
            "(?:(?:private|protected|public|readonly)\\s+)*\\??[A-Za-z_\\\\][\\w\\\\|]*\\s+\\$\\w+\\s*=\\s*[^,;]+,"
        ],
        // Off: with --with-uncovered a PublicVisibility mutant sits on a parameterless
        // method's signature line, which has no executable opcode under pcov/xdebug,
        // so it is reported Not Covered and can never be killed, whatever #[Covers]
        // says. Measured on pinned-http-client 2026-11-01: 4 of 4 such mutants were
        // Not Covered, none killed.
        "PublicVisibility": false,
        "Identical": {
            // ApcuBulkheadStore::lock's `apcu_add(...) === true` flipped to `!==`
            // genuinely breaks mutual exclusion under concurrent contention -
            // verified by hand-mutating the source and running
            // neverExceedsMaxConcurrentUnderRealForkContention (tests/Integration/
            // ApcuBulkheadIntegrationTest.php): 5/5 passed unmutated (under
            // `--cpus=1`, the saturation that used to make the old total-based
            // assertion fail), 5/5 failed mutated, peak concurrency 6-20 against
            // max 3. Re-verified after the #22 switch from total acquisitions to
            // peak concurrency. Not equivalent - ignored only because pcov coverage doesn't
            // propagate from pcntl_fork()'d children back to the parent process's
            // report, so infection's coverage-based test selection never picks
            // that test for this mutant and it escapes despite being killed.
            "ignore": [
                "Rasuvaeff\\Bulkhead\\ApcuBulkheadStore::lock"
            ]
        }
    }
}
