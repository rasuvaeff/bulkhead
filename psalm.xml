<?xml version="1.0"?>
<psalm
    errorLevel="1"
    findUnusedCode="false"
    resolveFromConfigFile="true"
>
    <projectFiles>
        <directory name="src"/>
        <ignoreFiles>
            <directory name="vendor"/>
        </ignoreFiles>
    </projectFiles>

    <!-- PhpRedisScriptRunner types against \Redis; the bundled stub lets psalm
         analyze it without ext-redis being installed. -->
    <enableExtensions>
        <extension name="redis"/>
    </enableExtensions>

    <issueHandlers>
        <!-- Redis identifies scripts for EVALSHA by their SHA-1; no other hash
             is accepted, so the weak-hash finding does not apply here. -->
        <WeakHash>
            <errorLevel type="info">
                <file name="src/Redis/PhpRedisScriptRunner.php"/>
                <file name="src/Redis/PredisScriptRunner.php"/>
            </errorLevel>
        </WeakHash>
    </issueHandlers>
</psalm>
